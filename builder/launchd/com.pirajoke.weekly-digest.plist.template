<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pirajoke.weekly-digest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__SCRIPTS_DIR__/weekly_digest.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__SCRIPTS_DIR__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/com.pirajoke.weekly-digest/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/com.pirajoke.weekly-digest/stderr.log</string>
</dict>
</plist>
