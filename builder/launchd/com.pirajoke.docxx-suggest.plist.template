<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pirajoke.docxx-suggest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__SCRIPTS_DIR__/docxx_suggest.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__SCRIPTS_DIR__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:__HOME__/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/com.pirajoke.docxx-suggest/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/com.pirajoke.docxx-suggest/stderr.log</string>
</dict>
</plist>
